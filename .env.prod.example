# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Variables de entorno de producción
# Copia este fichero como .env.prod y rellena los valores reales.
# NUNCA subas .env.prod al repositorio.
#
# Stack: Scaleway (fr-par). El stack anterior (Neon + Cloudflare R2 + n8n) se
# descartó en junio de 2026 y este fichero seguía documentándolo.
# Hoja completa en docs/CONTEXTO_ARQUITECTURA_DESPLIEGUE.md §18.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Scaleway Managed PostgreSQL, fr-par) ──────────────────────
# `sslmode` es obligatorio: el arranque falla en producción si no está.
DATABASE_URL=postgresql://user:pass@HOST:5432/gabinete?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios; el arranque lo comprueba en producción.
# Generar con: openssl rand -hex 32   (NO reutilizar el secreto de local)
SECRET=<jwt-secret-largo-y-aleatorio-min-32-chars>

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL pública del frontend (sin barra final). Controla CORS y el connectSrc de Helmet.
FRONTEND_URL=https://app.tudominio.es

# ── Object Storage (Scaleway, S3-compatible) ─────────────────────────────────
# Obligatorias en producción: sin ellas el arranque falla, en vez de dejar el
# archivado de documentos clínicos en un warn silencioso.
SCW_ACCESS_KEY=<access-key-scaleway>
SCW_SECRET_KEY=<secret-key-scaleway>
SCW_BUCKET_NAME=gabinete-archivos
SCW_REGION=fr-par

# ── Email (Scaleway Transactional Email, SMTP) ───────────────────────────────
# Migrado desde Resend (EE.UU.) por soberanía de datos: por aquí salen informes y
# expedientes con datos de salud de un menor (RGPD art. 9) y Scaleway ya es
# encargado del tratamiento con DPA firmado. Ver CONTEXTO_… §17.
#
# NO son obligatorias en el arranque todavía: TEM exige dominio verificado y aún
# no hay dominio. Sin ellas, EmailService entra en modo no-op y solo avisa por
# log. En cuanto el dominio esté verificado, pasarlas a obligatorias en
# `comprobarEntorno()` (backend/src/main.ts).
#
# Usuario SMTP    = ID del proyecto de Scaleway donde está creado el dominio TEM
# Contraseña SMTP = clave secreta de una API key con permiso sobre ese proyecto
SCW_TEM_PROJECT_ID=<project-id-scaleway>
SCW_TEM_SECRET_KEY=<secret-key-de-api-key-con-permiso-tem>
# Opcionales; estos son los valores por defecto del código.
# Puertos de TEM: 465 y 2465 (TLS implícito), 587 y 2587 (STARTTLS).
SCW_TEM_HOST=smtp.tem.scaleway.com
SCW_TEM_PORT=465

# Remitente. Su dominio debe estar verificado en TEM (SPF + DKIM + DMARC).
EMAIL_FROM=facturacion@tudominio.es

# ── Puppeteer (generación de PDF dentro del contenedor) ──────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT lo inyecta Scaleway automáticamente; no hace falta declararlo.
