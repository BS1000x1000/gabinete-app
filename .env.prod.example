# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Variables de entorno de producción
# Copia este fichero como .env.prod y rellena los valores reales.
# NUNCA subas .env.prod al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/gabinete?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32
SECRET=<jwt-secret-largo-y-aleatorio-min-32-chars>

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL pública del frontend (sin barra final)
FRONTEND_URL=https://tudominio.es

# ── n8n ───────────────────────────────────────────────────────────────────────
# Secreto compartido entre NestJS y n8n para autenticar webhooks internos
N8N_WEBHOOK_SECRET=<secret-compartido-nestjs-n8n>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── n8n base de datos (PostgreSQL separado de la app) ────────────────────────
N8N_DB_HOST=ep-xxx.eu-central-1.aws.neon.tech
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=<password-n8n>
