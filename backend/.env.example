# Base de datos PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secreto para firmar JWTs (genera uno largo y aleatorio)
SECRET=cambia_esto_por_un_secreto_seguro

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:4200

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# ── Object Storage (Scaleway, S3-compatible) ─────────────────────────────────
# En local se pueden dejar vacías: StorageService cae a disco (.almacen-local)
# y avisa por log. En producción son obligatorias y el arranque falla sin ellas.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET_NAME=
SCW_REGION=fr-par

# ── Email (Scaleway Transactional Email, SMTP) ───────────────────────────────
# Sustituye a Resend (EE.UU.) por soberanía de datos: por aquí salen informes y
# expedientes con datos de salud de un menor (RGPD art. 9).
# Sin PROJECT_ID + SECRET_KEY el envío queda en modo no-op y la app arranca igual.
#
#   SCW_TEM_PROJECT_ID  usuario SMTP = ID del proyecto de Scaleway donde está
#                       creado el dominio TEM (consola → Transactional Email).
#   SCW_TEM_SECRET_KEY  contraseña SMTP = clave secreta de una API key con
#                       permiso sobre ese proyecto. Puede ser la misma API key
#                       que la de Object Storage, pero se declara aparte para
#                       poder usar una clave con menos permisos.
#   SCW_TEM_HOST        opcional; por defecto smtp.tem.scaleway.com
#   SCW_TEM_PORT        opcional; por defecto 465 (TLS implícito).
#                       Alternativas de TEM: 2465 (TLS), 587 y 2587 (STARTTLS).
SCW_TEM_PROJECT_ID=
SCW_TEM_SECRET_KEY=
SCW_TEM_HOST=smtp.tem.scaleway.com
SCW_TEM_PORT=465

# Remitente de los correos. Su dominio debe estar verificado en TEM.
EMAIL_FROM=facturacion@gabinete.es
