# Base de datos PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secreto para firmar JWTs (genera uno largo y aleatorio)
SECRET=cambia_esto_por_un_secreto_seguro

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:4200

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# ── Object Storage (Scaleway, S3-compatible) ─────────────────────────────────
# En local se pueden dejar vacías: StorageService cae a disco (.almacen-local)
# y avisa por log. En producción son obligatorias y el arranque falla sin ellas.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET_NAME=
SCW_REGION=fr-par

# Resend (email de facturas) — https://resend.com
# Sin clave, el envío de email queda en modo no-op y la app arranca igual.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=facturacion@gabinete.es
