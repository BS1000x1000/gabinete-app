// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SEGURIDAD Y ROLES
// ============================================================

model Rol {
  id          String   @id @default(uuid())
  nombreRol   String   @unique @map("nombre_rol")
  codigo      String   @unique @map("codigo_rol")
  descripcion String?
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  trabajadores Trabajador[]

  @@map("roles")
}

model Trabajador {
  id                String    @id @default(uuid())
  username          String    @unique
  passwordHash      String    @map("password_hash")
  nombre            String
  apellidos         String
  email             String    @unique
  telefono          String?
  img               String?   @map("url_imagen_perfil")
  fechaContratacion DateTime? @map("fecha_contratacion")
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("fecha_creacion")
  updatedAt         DateTime  @updatedAt @map("ultima_actualizacion")

  rolId String @map("id_rol")
  rol   Rol    @relation(fields: [rolId], references: [id])

  clientesAsignados  ClienteTrabajador[]
  sesiones           Sesion[]
  informes           Informe[]
  registrosCreados   RegistroDiario[]
  objetivosAsignados Objetivo[] @relation("ObjetivosAsignados")
  notificaciones     Notificacion[]

  @@map("trabajadores")
}

// ============================================================
// COLEGIOS Y CLIENTES
// ============================================================

model Colegio {
  id                    String  @id @default(uuid())
  nombre                String  @unique
  direccionColegio      String  @map("direccion_colegio")
  ctoColegioUno         String  @map("nombre_primero")
  ctoTelefonoUno        String  @map("telefono_primero")
  ctoEmailColegioUno    String  @map("email_primero")
  ctoRelacionColegioUno String  @map("txt_primero")
  ctoColegioDos         String? @map("nombre_segundo")
  ctoTelefonoDos        String? @map("telefono_segundo")
  ctoEmailColegioDos    String? @map("email_segundo")
  ctoRelacionColegioDos String? @map("txt_segundo")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  clientes Cliente[]

  @@map("colegios")
}

model Cliente {
  id              String    @id @default(uuid())
  idCarpetaDrive  String?   @map("id_carpeta_drive")
  nombre          String
  apellidos       String
  fechaNacimiento DateTime? @map("fecha_nacimiento")
  dni             String    @unique
  domicilio       String
  provincia       String
  ciudad          String
  curso           String
  fechaInicio     DateTime? @map("fecha_inicio")
  fechaAlta       DateTime? @default(now()) @map("fecha_alta")
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("fecha_creacion")
  updatedAt       DateTime  @updatedAt @map("ultima_actualizacion")

  colegioId String?  @map("id_colegio")
  colegio   Colegio? @relation(fields: [colegioId], references: [id])

  trabajadoresAsignados       ClienteTrabajador[]
  disponibilidad              DisponibilidadCliente[]
  sesiones                    Sesion[]
  informes                    Informe[]
  contactosFamiliares         Familiar[]
  sanitario                   Sanitario?
  registrosDiarios            RegistroDiario[]
  objetivosGeneralesAsignados ClienteObjetivo[]
  objetivosEspecificos        Objetivo[]
  bonos                       Bono[]
  notificaciones              Notificacion[]

  @@map("clientes")
}

model ClienteTrabajador {
  id           String   @id @default(uuid())
  clienteId    String   @map("id_cliente")
  trabajadorId String   @map("id_trabajador")
  tipoTerapia  TipoSesion @map("tipo_terapia")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("fecha_asignacion")
  updatedAt    DateTime @updatedAt @map("fecha_actualizacion")

  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  horarios DisponibilidadClienteTrabajador[]

  @@unique([clienteId, trabajadorId, tipoTerapia])
  @@map("clientes_trabajadores")
}

// ============================================================
// DISPONIBILIDAD Y SESIONES
// ============================================================

model DisponibilidadCliente {
  id         String @id @default(uuid())
  diaSemana  Int
  horaInicio String
  horaFin    String

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  @@map("disponibilidad_clientes")
}

model DisponibilidadClienteTrabajador {
  id         String @id @default(uuid())
  diaSemana  Int
  horaInicio String
  horaFin    String

  clienteTrabajadorId String            @map("id_cliente_trabajador")
  clienteTrabajador   ClienteTrabajador @relation(fields: [clienteTrabajadorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")

  @@map("disponibilidad_cliente_trabajador")
}

model Sesion {
  id                  String       @id @default(uuid())
  fechaHoraInicio     DateTime     @map("fecha_hora_inicio")
  fechaHoraFin        DateTime     @map("fecha_hora_fin")
  estado              EstadoSesion @default(PROGRAMADA)
  tipoSesion          TipoSesion   @default(PEDAGOGIA)
  notas               String?      @db.Text
  objetivosTrabajados String?      @db.Text
  createdAt           DateTime     @default(now()) @map("fecha_creacion")
  updatedAt           DateTime     @updatedAt @map("ultima_actualizacion")

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  bonoId  String?  @map("id_bono")
  bono    Bono?    @relation(fields: [bonoId], references: [id])

  @@map("sesiones")
}

// ============================================================
// FAMILIARES Y SANITARIO
// ============================================================

model Familiar {
  id                  String  @id @default(uuid())
  nombre              String
  apellidos           String
  dni                 String?
  parentesco          String
  telefono            String
  email               String?
  esResponsablePago   Boolean @default(false) @map("es_responsable_pago")
  esContactoPrincipal Boolean @default(true)  @map("es_contacto_principal")
  whatsapp            Boolean @default(true)

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  bonos  Bono[]

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("familiares")
}

model Sanitario {
  id               String   @id @default(uuid())
  diagnostico      String   @db.Text
  centroSalud      String   @map("centro_salud")
  tratamientos     String   @db.Text
  medicacion       String   @db.Text
  alergias         String?  @db.Text
  adaptaciones     Boolean  @default(false)
  tipoAdaptaciones String?  @map("tipo_adaptaciones")
  especialistas    String[]
  apoyos           Boolean  @default(false)

  clienteId String  @unique @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("datos_sanitarios")
}

// ============================================================
// INFORMES
// ============================================================

model Informe {
  id     String        @id @default(uuid())
  titulo String
  estado EstadoInforme @default(BORRADOR)

  tipoInforme  TipoInforme @default(INICIAL) @map("tipo_informe")
  periodoDesde DateTime?   @map("periodo_desde")
  periodoHasta DateTime?   @map("periodo_hasta")

  // Sección 1
  motivoConsulta String? @db.Text @map("motivo_consulta")
  // Sección 2
  analisisInformacion String? @db.Text @map("analisis_informacion")
  // Sección 3
  evaluacionInicial String? @db.Text @map("evaluacion_inicial")
  // Sección 4
  objetivosGeneralesTexto String? @db.Text @map("objetivos_generales_texto")

  // Solo para SEGUIMIENTO
  evolucionObservada    String? @db.Text @map("evolucion_observada")
  objetivosProximoCurso String? @db.Text @map("objetivos_proximo_curso")
  recomendaciones       String? @db.Text

  // Snapshot JSON — garantiza que el PDF sea siempre reproducible
  objetivosSnapshotJson String? @db.Text @map("objetivos_snapshot_json")

  urlDocumentoFinal String? @map("url_documento_final")

  // Campo legado — compatibilidad con datos existentes
  contenido String? @db.Text

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  @@map("informes")
}

// ============================================================
// REGISTROS DIARIOS
// ============================================================

model RegistroDiario {
  id            String   @id @default(uuid())
  fechaRegistro DateTime @default(now()) @map("fecha_registro")
  contenido     String   @db.Text

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  createdAt                    DateTime                 @default(now()) @map("fecha_creacion")
  updatedAt                    DateTime                 @updatedAt @map("ultima_actualizacion")
  objetivosGeneralesTrabajados RegistroDiarioObjetivo[]

  @@map("registros_diarios")
}

// ============================================================
// OBJETIVOS
// ============================================================

model Objetivo {
  id               String         @id @default(uuid())
  titulo           String
  descripcion      String?        @db.Text
  fechaInicio      DateTime       @default(now()) @map("fecha_inicio")
  fechaFinPrevista DateTime?      @map("fecha_fin_prevista")
  estado           EstadoObjetivo @default(PENDIENTE)

  clienteId               String     @map("id_cliente")
  cliente                 Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorResponsableId String     @map("id_trabajador_responsable")
  trabajadorResponsable   Trabajador @relation("ObjetivosAsignados", fields: [trabajadorResponsableId], references: [id])

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("objetivos")
}

model AreaDesarrollo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?  @db.Text
  color       String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  objetivosGenerales ObjetivoGeneral[]

  @@map("areas_desarrollo")
}

model ObjetivoGeneral {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  areaDesarrolloId String         @map("id_area_desarrollo")
  areaDesarrollo   AreaDesarrollo @relation(fields: [areaDesarrolloId], references: [id])

  clientesQueLoTienen     ClienteObjetivo[]
  registrosDondeSeTrabajo RegistroDiarioObjetivo[]

  @@map("objetivos_generales")
}

// ============================================================
// SISTEMA GAS — DISEÑO NORMALIZADO
// ============================================================

model ClienteObjetivo {
  id              String   @id @default(uuid())
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("fecha_creacion")
  updatedAt       DateTime @updatedAt @map("fecha_actualizacion")

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  vecesTrabajado        Int       @default(0) @map("veces_trabajado")
  ultimaVez             DateTime? @map("ultima_vez_trabajado")
  progreso              Int       @default(0)
  notas                 String?

  // Desnormalizado para acceso rápido — se actualiza al crear una EvaluacionGAS
  nivelGASActual        Int?      @map("nivel_gas_actual")
  fechaUltimaEvaluacion DateTime? @map("fecha_ultima_evaluacion")

  objetivoGeneralId String          @map("id_objetivo_general")
  objetivoGeneral   ObjetivoGeneral @relation(fields: [objetivoGeneralId], references: [id], onDelete: Cascade)

  descripcionesNiveles DescripcionNivelGAS[]
  evaluaciones         EvaluacionGAS[]

  @@unique([clienteId, objetivoGeneralId])
  @@map("clientes_objetivos")
}

model DescripcionNivelGAS {
  id          String @id @default(uuid())
  nivel       Int    // -2, -1, 0, 1, 2
  descripcion String @db.Text

  clienteObjetivoId String          @map("id_cliente_objetivo")
  clienteObjetivo   ClienteObjetivo @relation(fields: [clienteObjetivoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")

  @@unique([clienteObjetivoId, nivel])
  @@map("descripcion_niveles_gas")
}

model EvaluacionGAS {
  id    String   @id @default(uuid())
  nivel Int      // -2, -1, 0, 1, 2
  notas String?  @db.Text
  fecha DateTime @default(now())

  clienteObjetivoId String          @map("id_cliente_objetivo")
  clienteObjetivo   ClienteObjetivo @relation(fields: [clienteObjetivoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")

  @@map("evaluaciones_gas")
}

model RegistroDiarioObjetivo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("fecha_creacion")

  registroDiarioId String         @map("id_registro_diario")
  registroDiario   RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)

  objetivoGeneralId String          @map("id_objetivo_general")
  objetivoGeneral   ObjetivoGeneral @relation(fields: [objetivoGeneralId], references: [id], onDelete: Cascade)

  @@unique([registroDiarioId, objetivoGeneralId])
  @@map("registros_diarios_objetivos")
}

model Bono {
  id                 String      @id @default(uuid())
  totalSesiones      Int         @map("total_sesiones")
  sesionesConsumidas Int         @default(0) @map("sesiones_consumidas")
  precio             Decimal     @db.Decimal(10, 2)
  estado             EstadoBono  @default(ACTIVO)
  pagado             Boolean     @default(false)
  metodoPago         String?     @map("metodo_pago")
  fechaPago          DateTime?   @map("fecha_pago")
  fechaInicio        DateTime    @default(now()) @map("fecha_inicio")
  fechaFin           DateTime?   @map("fecha_fin")
  notas              String?     @db.Text
  createdAt          DateTime    @default(now()) @map("fecha_creacion")
  updatedAt          DateTime    @updatedAt @map("ultima_actualizacion")

  clienteId       String    @map("id_cliente")
  cliente         Cliente   @relation(fields: [clienteId], references: [id])

  familiarPagoId  String?   @map("id_familiar_pago")
  familiarPago    Familiar? @relation(fields: [familiarPagoId], references: [id])

  sesiones        Sesion[]

  @@map("bonos")
}

// ============================================================
// ENUMS
// ============================================================

enum EstadoSesion {
  PROGRAMADA
  COMPLETADA
  CANCELADA_CON_AVISO
  CANCELADA_SIN_AVISO
  VACACIONES
}

enum TipoSesion {
  PEDAGOGIA
  NEUROPSICOLOGIA
  LOGOPEDIA
  TERAPIA_OCUPACIONAL
  EVALUACION
  REUNION_COLEGIO
}

enum EstadoInforme {
  BORRADOR
  REVISION
  FINALIZADO
}

enum TipoInforme {
  INICIAL
  SEGUIMIENTO
}

enum EstadoObjetivo {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  CANCELADO
}

enum EstadoBono {
  ACTIVO
  CONSUMIDO
  CANCELADO
}

// ============================================================
// NOTIFICACIONES
// ============================================================

enum TipoNotificacion {
  INFORME_INICIAL_PENDIENTE
  INFORME_SEGUIMIENTO_PENDIENTE
  BONO_AGOTADO
  BONO_CASI_AGOTADO
  BONO_PENDIENTE_PAGO
  SIN_SESIONES_RECIENTES
  OBJETIVO_SIN_EVALUAR
  INFORME_EN_BORRADOR
  SESION_SIN_BONO
}

enum PrioridadNotif {
  URGENTE
  ALTA
  MEDIA
  BAJA
}

model Notificacion {
  id            String           @id @default(uuid())
  tipo          TipoNotificacion
  prioridad     PrioridadNotif
  titulo        String
  mensaje       String           @db.Text
  leida         Boolean          @default(false)
  descartada    Boolean          @default(false)
  accionUrl     String?
  reglaOrigen   String           @map("regla_origen")
  referenciaId  String?          @map("referencia_id")
  fechaCreacion DateTime         @default(now()) @map("fecha_creacion")
  fechaLectura  DateTime?        @map("fecha_lectura")

  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  clienteId    String?    @map("id_cliente")
  cliente      Cliente?   @relation(fields: [clienteId], references: [id])

  @@map("notificaciones")
}