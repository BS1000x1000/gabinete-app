// FACTURACIÓN (Hito R3)
// ============================================================

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

model Factura {
  id               String @id @default(uuid())
  numero           Int
  numeroFormateado String @map("numero_formateado")
  anio             Int

  trabajadorId String  @map("id_trabajador")
  clienteId    String  @map("id_cliente")
  contratoId   String? @map("id_contrato")

  fechaEmision        DateTime @map("fecha_emision")
  periodoFacturado    String   @map("periodo_facturado") // "2026-09"
  concepto            String   @db.Text
  importe             Decimal  @db.Decimal(10, 2)
  ivaPorcentaje       Decimal  @default(0) @map("iva_porcentaje") @db.Decimal(4, 2)
  ivaImporte          Decimal  @default(0) @map("iva_importe") @db.Decimal(10, 2)
  retencionPorcentaje Decimal  @default(0) @map("retencion_porcentaje") @db.Decimal(4, 2)
  retencionImporte    Decimal  @default(0) @map("retencion_importe") @db.Decimal(10, 2)
  exencionIvaTexto    String?  @map("exencion_iva_texto")
  total               Decimal  @db.Decimal(10, 2)

  estado          EstadoFactura @default(PENDIENTE)
  fechaPago       DateTime?     @map("fecha_pago")
  metodoPago      String?       @map("metodo_pago")
  urlPdfR2        String?       @map("url_pdf_r2")
  emailEnviado    Boolean       @default(false) @map("email_enviado")
  fechaEnvioEmail DateTime?     @map("fecha_envio_email")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  trabajador Trabajador        @relation("FacturasEmitidas", fields: [trabajadorId], references: [id])
  cliente    Cliente           @relation("FacturasRecibidas", fields: [clienteId], references: [id])
  contrato   ContratoServicio? @relation(fields: [contratoId], references: [id])
  entregas   EnvioGestoriaFactura[]

  @@unique([trabajadorId, anio, numero])
  @@unique([contratoId, periodoFacturado])
  @@index([trabajadorId, anio])
  @@index([clienteId])
  @@index([estado])
  /// Los packs para la gestoria y la generacion por periodo filtran por aqui.
  @@index([periodoFacturado])
  @@map("facturas")
}

model ContadorFactura {
  trabajadorId String @map("id_trabajador")
  anio         Int
  ultimoNumero Int    @default(0) @map("ultimo_numero")

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@id([trabajadorId, anio])
  @@map("contador_facturas")
}

// ============================================================
// ENTREGA A LA GESTORIA
// ============================================================

enum PeriodicidadEnvio {
  NINGUNA
  MENSUAL
  TRIMESTRAL
}

enum EstadoEnvioGestoria {
  /// Preparado pero sin salir: el email no estaba configurado o fallo el envio.
  PENDIENTE
  ENVIADO
  ERROR
}

/// Una entrega de facturas a la gestoria de un autonomo.
///
/// Existe para responder a dos preguntas que antes no tenian respuesta: "?ya
/// mande el 3T?" y "?que facturas quedan por entregar?". Sin esto la unica
/// forma de saberlo era mirar la bandeja de enviados.
model EnvioGestoria {
  id           String @id @default(uuid())
  trabajadorId String @map("id_trabajador")

  /// Periodos facturados que cubre, inclusive: "2026-07".."2026-09".
  periodoDesde String @map("periodo_desde")
  periodoHasta String @map("periodo_hasta")

  emailDestino String  @map("email_destino")
  numFacturas  Int     @map("num_facturas")
  totalImporte Decimal @map("total_importe") @db.Decimal(10, 2)

  /// Clave del ZIP archivado en Object Storage, para poder re-descargar lo que
  /// se mando exactamente, no una reconstruccion parecida.
  storageKey String? @map("storage_key")

  estado     EstadoEnvioGestoria @default(PENDIENTE)
  error      String?             @db.Text
  /// `true` cuando lo lanzo el cron, `false` cuando lo mando una persona.
  automatico Boolean             @default(false)
  fechaEnvio DateTime?           @map("fecha_envio")
  createdAt  DateTime            @default(now()) @map("fecha_creacion")

  trabajador Trabajador             @relation(fields: [trabajadorId], references: [id])
  facturas   EnvioGestoriaFactura[]

  @@index([trabajadorId])
  @@index([estado])
  @@map("envios_gestoria")
}

/// Que facturas concretas iban en cada entrega. Tabla puente en vez de una lista
/// de ids para poder preguntar por el otro lado: "?esta factura ya se entrego?".
model EnvioGestoriaFactura {
  envioId   String @map("id_envio")
  facturaId String @map("id_factura")

  envio   EnvioGestoria @relation(fields: [envioId], references: [id], onDelete: Cascade)
  factura Factura       @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@id([envioId, facturaId])
  @@index([facturaId])
  @@map("envios_gestoria_facturas")
}

// ============================================================
// AUDIT LOG (RGPD)
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  evento    String // 'LOGIN_OK' | 'LOGIN_FAIL' | 'LOGOUT' | 'PASSWORD_CHANGE' | 'ACCESO_FICHA'
  userId    String?  @map("user_id") // null en LOGIN_FAIL si el usuario no existe
  username  String?
  ip        String?
  recurso   String? // clienteId, informeId, etc. — contexto del acceso
  metadata  Json? // datos adicionales en formato libre
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([evento])
  @@index([createdAt])
  @@map("audit_log")
}
