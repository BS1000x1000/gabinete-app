// ============================================================
// CONSENTIMIENTO RGPD (historico por cliente)
// ============================================================

/// Fuente de verdad del consentimiento RGPD. Cada fila es un hecho ocurrido
/// (se otorgo o se revoco) y nunca se modifica: el historico se lee entero.
model ConsentimientoRgpd {
  id           String  @id @default(uuid())
  aceptado     Boolean // true = acepta, false = revoca
  /// Version de la plantilla que la familia firmo, p. ej.
  /// "consentimiento-datos-v1-2026-09". El RAT exige poder decir que texto exacto acepto.
  versionTexto String  @map("version_texto")

  /// Solo para registros manuales sin plantilla conocida. Cuando hay documento,
  /// la evidencia es el PDF y no una copia del texto.
  textoConsentimiento  String?   @map("texto_consentimiento") @db.Text
  fechaRegistro        DateTime  @default(now()) @map("fecha_registro")
  /// La fecha que la familia escribe en el papel, distinta de cuando se registra.
  fechaFirma           DateTime? @map("fecha_firma")
  ipRegistro           String?   @map("ip_registro")
  /// Por que se registro fuera del circuito de firma del expediente.
  motivoRegistroManual String?   @map("motivo_registro_manual") @db.Text

  /// Las tres casillas que la familia marca por separado en el documento, mas
  /// el consentimiento del propio menor si tiene 14 o mas anos (LOPDGDD art. 7).
  autorizaInformesTerceros   Boolean @default(false) @map("autoriza_informes_terceros")
  autorizaCoordinacionCentro Boolean @default(false) @map("autoriza_coordinacion_centro")
  autorizaImagenes           Boolean @default(false) @map("autoriza_imagenes")
  consentimientoMenor14      Boolean @default(false) @map("consentimiento_menor_14")

  /// La evidencia: el PDF firmado que devolvio la familia.
  documentoId String?           @unique @map("id_documento")
  documento   DocumentoCliente? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  /// Quien firma. Son varios a proposito: con dos titulares de la patria
  /// potestad lo normal es que firmen ambos, y el documento tiene dos bloques
  /// de representante legal.
  firmantes ConsentimientoFirmante[]

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador") // quien lo registra en la app
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  @@index([clienteId])
  @@index([clienteId, fechaRegistro])
  @@map("consentimientos_rgpd")
}

/// Cada tutor legal que suscribe un consentimiento. Uno cuando solo hay un
/// titular de la patria potestad; los dos cuando los hay.
model ConsentimientoFirmante {
  consentimientoId String             @map("id_consentimiento")
  consentimiento   ConsentimientoRgpd @relation(fields: [consentimientoId], references: [id], onDelete: Cascade)
  familiarId       String             @map("id_familiar")
  familiar         Familiar           @relation(fields: [familiarId], references: [id])

  @@id([consentimientoId, familiarId])
  @@index([familiarId])
  @@map("consentimiento_firmantes")
}

