// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SEGURIDAD Y ROLES
// ============================================================

model Rol {
  id          String   @id @default(uuid())
  nombreRol   String   @unique @map("nombre_rol")
  codigo      String   @unique @map("codigo_rol")
  descripcion String?
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  trabajadores Trabajador[]

  @@map("roles")
}

model Trabajador {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String    @map("password_hash")
  nombre               String
  apellidos            String
  email                String    @unique
  telefono             String?
  img                  String?   @map("url_imagen_perfil")
  numeroColegiado      String?   @map("numero_colegiado")
  especialidad         String?
  fechaContratacion    DateTime? @map("fecha_contratacion")
  urlVideollamada      String?   @map("url_videollamada")
  activo               Boolean   @default(true)
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  createdAt            DateTime  @default(now()) @map("fecha_creacion")
  updatedAt            DateTime  @updatedAt @map("ultima_actualizacion")

  // Datos fiscales del autónomo (Hito R)
  nifFiscal          String?  @map("nif_fiscal")
  nombreFiscal       String?  @map("nombre_fiscal")
  direccionFiscal    String?  @map("direccion_fiscal") @db.Text
  codigoPostalFiscal String?  @map("codigo_postal_fiscal")
  ciudadFiscal       String?  @map("ciudad_fiscal")
  provinciaFiscal    String?  @map("provincia_fiscal")
  iban               String?
  retencionIrpf      Decimal? @map("retencion_irpf") @db.Decimal(4, 2)
  emailFacturacion   String?  @map("email_facturacion")

  /// Gestoria de este autonomo. Va por trabajador y no por gabinete: cada uno
  /// tiene su circuito fiscal y puede tener su propio asesor.
  nombreGestoria       String?            @map("nombre_gestoria")
  emailGestoria        String?            @map("email_gestoria")
  periodicidadGestoria PeriodicidadEnvio  @default(NINGUNA) @map("periodicidad_gestoria")

  // Datos profesionales que aparecen en el contrato y los consentimientos.
  // Van por trabajador porque cada terapeuta es autonoma independiente: su
  // colegio, su numero de colegiada y su poliza son suyos, no del gabinete.
  colegioProfesional   String? @map("colegio_profesional")
  numeroPoliza         String? @map("numero_poliza")
  /// Solo si el domicilio profesional difiere del fiscal; si es null, se usa el fiscal.
  direccionProfesional String? @map("direccion_profesional") @db.Text

  rolId String @map("id_rol")
  rol   Rol    @relation(fields: [rolId], references: [id])

  clientesAsignados   ClienteTrabajador[]
  sesiones            Sesion[]
  informes            Informe[]
  registrosCreados    RegistroDiario[]
  objetivosAsignados  Objetivo[]           @relation("ObjetivosAsignados")
  notificaciones      Notificacion[]
  consentimientosRgpd ConsentimientoRgpd[]
  eventosCreados      EventoAgenda[]       @relation("EventosCreados")
  eventosParticipante EventoParticipante[] @relation("EventosParticipante")
  horariosAdmin       HorarioAdmin[]
  contratosServicio   ContratoServicio[]
  periodosVacaciones  PeriodoVacaciones[]
  facturasEmitidas    Factura[]            @relation("FacturasEmitidas")
  contadorFacturas    ContadorFactura[]
  documentosSubidos   DocumentoCliente[]   @relation("DocumentosSubidos")
  horarioLaboral      HorarioLaboral[]
  enviosGestoria      EnvioGestoria[]

  @@map("trabajadores")
}

// ============================================================
// COLEGIOS Y CLIENTES
// ============================================================

model Colegio {
  id                    String  @id @default(uuid())
  nombre                String  @unique
  direccionColegio      String  @map("direccion_colegio")
  ctoColegioUno         String  @map("nombre_primero")
  ctoTelefonoUno        String  @map("telefono_primero")
  ctoEmailColegioUno    String  @map("email_primero")
  ctoRelacionColegioUno String  @map("txt_primero")
  ctoColegioDos         String? @map("nombre_segundo")
  ctoTelefonoDos        String? @map("telefono_segundo")
  ctoEmailColegioDos    String? @map("email_segundo")
  ctoRelacionColegioDos String? @map("txt_segundo")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  clientes Cliente[]

  @@map("colegios")
}

model Cliente {
  id                         String    @id @default(uuid())
  idCarpetaDrive             String?   @map("id_carpeta_drive")
  nombre                     String
  apellidos                  String
  fechaNacimiento            DateTime? @map("fecha_nacimiento")
  /// Opcional: muchos menores no tienen DNI todavia. Se guarda NULL (nunca ''),
  /// porque en Postgres varios NULL conviven en un indice unico pero '' colisiona.
  dni                        String?   @unique
  domicilio                  String
  provincia                  String
  ciudad                     String
  curso                      String
  fechaInicio                DateTime? @map("fecha_inicio")
  fechaAlta                  DateTime? @default(now()) @map("fecha_alta")
  activo                     Boolean   @default(true)
  /// Cache derivada del ultimo ConsentimientoRgpd. Solo la escribe
  /// ConsentimientosService; nadie mas debe tocar estos tres campos.
  consentimientoRgpd         Boolean   @default(false) @map("consentimiento_rgpd")
  consentimientoFecha        DateTime? @map("consentimiento_fecha")
  consentimientoTrabajadorId String?   @map("consentimiento_trabajador_id")
  deletedAt                  DateTime? @map("deleted_at")
  createdAt                  DateTime  @default(now()) @map("fecha_creacion")
  updatedAt                  DateTime  @updatedAt @map("ultima_actualizacion")

  // Datos del pagador/tutor para facturación (Hito R)
  nifTutorPagador      String? @map("nif_tutor_pagador")
  nombreTutorPagador   String? @map("nombre_tutor_pagador")
  direccionFiscalTutor String? @map("direccion_fiscal_tutor") @db.Text
  codigoPostalTutor    String? @map("codigo_postal_tutor")
  ciudadTutor          String? @map("ciudad_tutor")
  emailFacturacion     String? @map("email_facturacion_cliente")

  colegioId String?  @map("id_colegio")
  colegio   Colegio? @relation(fields: [colegioId], references: [id])

  trabajadoresAsignados       ClienteTrabajador[]
  disponibilidad              DisponibilidadCliente[]
  sesiones                    Sesion[]
  informes                    Informe[]
  contactosFamiliares         Familiar[]
  sanitario                   Sanitario?
  escolar                     Escolar?
  registrosDiarios            RegistroDiario[]
  objetivosGeneralesAsignados ClienteObjetivo[]
  objetivosEspecificos        Objetivo[]
  bonos                       Bono[]
  notificaciones              Notificacion[]
  consentimientosRgpd         ConsentimientoRgpd[]
  contratosServicio           ContratoServicio[]
  facturasRecibidas           Factura[]               @relation("FacturasRecibidas")
  documentos                  DocumentoCliente[]

  @@map("clientes")
}

model ClienteTrabajador {
  id           String     @id @default(uuid())
  clienteId    String     @map("id_cliente")
  trabajadorId String     @map("id_trabajador")
  tipoTerapia  TipoSesion @map("tipo_terapia")
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("fecha_asignacion")
  updatedAt    DateTime   @updatedAt @map("fecha_actualizacion")

  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  horarios DisponibilidadClienteTrabajador[]

  @@unique([clienteId, trabajadorId, tipoTerapia])
  @@map("clientes_trabajadores")
}

// ============================================================
// DISPONIBILIDAD Y SESIONES
// ============================================================

model DisponibilidadCliente {
  id         String @id @default(uuid())
  diaSemana  Int
  horaInicio String
  horaFin    String

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  @@map("disponibilidad_clientes")
}

model DisponibilidadClienteTrabajador {
  id         String @id @default(uuid())
  diaSemana  Int
  horaInicio String
  horaFin    String

  clienteTrabajadorId String            @map("id_cliente_trabajador")
  clienteTrabajador   ClienteTrabajador @relation(fields: [clienteTrabajadorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")

  @@map("disponibilidad_cliente_trabajador")
}

model Sesion {
  id                  String          @id @default(uuid())
  fechaHoraInicio     DateTime        @map("fecha_hora_inicio")
  fechaHoraFin        DateTime        @map("fecha_hora_fin")
  estado              EstadoSesion    @default(PROGRAMADA)
  tipoSesion          TipoSesion      @default(PEDAGOGIA)
  modalidad           ModalidadSesion @default(PRESENCIAL)
  notas               String?         @db.Text
  objetivosTrabajados String?         @db.Text
  createdAt           DateTime        @default(now()) @map("fecha_creacion")
  updatedAt           DateTime        @updatedAt @map("ultima_actualizacion")

  clienteId    String            @map("id_cliente")
  cliente      Cliente           @relation(fields: [clienteId], references: [id])
  trabajadorId String            @map("id_trabajador")
  trabajador   Trabajador        @relation(fields: [trabajadorId], references: [id])
  bonoId       String?           @map("id_bono")
  bono         Bono?             @relation(fields: [bonoId], references: [id])
  contratoId   String?           @map("id_contrato")
  contrato     ContratoServicio? @relation("SesionesContrato", fields: [contratoId], references: [id])

  /// Un cliente no puede tener dos sesiones con el mismo terapeuta empezando en
  /// el mismo instante. Es lo que hace que `skipDuplicates` funcione de verdad en
  /// el generador del contrato y en el cron: hasta ahora la tabla no tenia ninguna
  /// constraint unica, asi que `skipDuplicates` era un no-op silencioso.
  /// Deliberadamente NO incluye el contrato: asi una sesion suelta (evaluacion,
  /// extra) sigue pudiendo crearse a cualquier otra hora, o a la misma con otro
  /// terapeuta, que es un caso real (reunion de colegio con dos hermanos).
  @@unique([clienteId, trabajadorId, fechaHoraInicio])
  @@index([clienteId])
  @@index([trabajadorId])
  @@index([fechaHoraInicio])
  @@index([trabajadorId, fechaHoraInicio])
  @@map("sesiones")
}

// ============================================================
// FAMILIARES Y SANITARIO
// ============================================================

model Familiar {
  id                  String  @id @default(uuid())
  nombre              String
  apellidos           String
  dni                 String?
  parentesco          String
  telefono            String
  email               String?
  esResponsablePago   Boolean @default(false) @map("es_responsable_pago")
  esContactoPrincipal Boolean @default(true) @map("es_contacto_principal")
  whatsapp            Boolean @default(true)
  /// Firma el contrato y los consentimientos. `esContactoPrincipal` no sirve
  /// para esto: nace en true para todos y significa "a quien se llama primero".
  esTutorLegal        Boolean @default(false) @map("es_tutor_legal")

  clienteId            String                   @map("id_cliente")
  cliente              Cliente                  @relation(fields: [clienteId], references: [id])
  bonos                Bono[]
  /// Consentimientos que ha firmado, como tutor legal del menor.
  firmasConsentimiento ConsentimientoFirmante[]

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("familiares")
}

/// Datos sanitarios del cliente. Todo opcional: en el alta a menudo aún no hay
/// diagnóstico. `especialistas` son profesionales sanitarios EXTERNOS que atienden
/// al menor (psicólogo, logopeda, neuropediatra...). Lo escolar vive en `Escolar`.
model Sanitario {
  id            String   @id @default(uuid())
  diagnostico   String?  @db.Text
  centroSalud   String?  @map("centro_salud")
  tratamientos  String?  @db.Text
  especialistas String[]

  clienteId String  @unique @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("datos_sanitarios")
}

/// Situación escolar DEL NIÑO. Deliberadamente separado de `Colegio`, que es una
/// entidad compartida por muchos clientes: las adaptaciones curriculares, los apoyos
/// y los especialistas del centro (PT, AL, orientador...) son del alumno concreto,
/// no del colegio, y guardarlos en `Colegio` los filtraría entre hermanos de centro.
model Escolar {
  id               String   @id @default(uuid())
  adaptaciones     Boolean  @default(false)
  tipoAdaptaciones String?  @map("tipo_adaptaciones")
  apoyos           Boolean  @default(false)
  especialistas    String[]

  clienteId String  @unique @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("datos_escolares")
}

// ============================================================
// INFORMES
// ============================================================

model Informe {
  id     String        @id @default(uuid())
  titulo String
  estado EstadoInforme @default(BORRADOR)

  tipoInforme  TipoInforme @default(INICIAL) @map("tipo_informe")
  periodoDesde DateTime?   @map("periodo_desde")
  periodoHasta DateTime?   @map("periodo_hasta")

  // Sección 1
  motivoConsulta          String? @map("motivo_consulta") @db.Text
  // Sección 2
  analisisInformacion     String? @map("analisis_informacion") @db.Text
  // Sección 3
  evaluacionInicial       String? @map("evaluacion_inicial") @db.Text
  // Sección 4
  objetivosGeneralesTexto String? @map("objetivos_generales_texto") @db.Text

  // Solo para SEGUIMIENTO
  evolucionObservada    String? @map("evolucion_observada") @db.Text
  objetivosProximoCurso String? @map("objetivos_proximo_curso") @db.Text
  recomendaciones       String? @db.Text

  // Snapshot JSON — garantiza que el PDF sea siempre reproducible
  objetivosSnapshotJson String? @map("objetivos_snapshot_json") @db.Text

  urlDocumentoFinal String? @map("url_documento_final")

  // Campo legado — compatibilidad con datos existentes
  contenido String? @db.Text

  enviadoFamiliaAt DateTime? @map("enviado_familia_at")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  @@index([clienteId])
  @@index([trabajadorId])
  @@index([createdAt])
  @@map("informes")
}

// ============================================================
// REGISTROS DIARIOS
// ============================================================

model RegistroDiario {
  id                  String   @id @default(uuid())
  fechaRegistro       DateTime @default(now()) @map("fecha_registro")
  contenido           String   @db.Text
  proximaSesion       String?  @map("proxima_sesion") @db.Text
  compartirConFamilia Boolean  @default(true) @map("compartir_con_familia")

  clienteId    String     @map("id_cliente")
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorId String     @map("id_trabajador")
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  etiquetas                    EtiquetaRegistro[]       @default([REGISTRO_DIARIO])
  createdAt                    DateTime                 @default(now()) @map("fecha_creacion")
  updatedAt                    DateTime                 @updatedAt @map("ultima_actualizacion")
  objetivosGeneralesTrabajados RegistroDiarioObjetivo[]

  @@index([clienteId])
  @@index([trabajadorId])
  @@index([fechaRegistro])
  @@map("registros_diarios")
}

// ============================================================
// OBJETIVOS
// ============================================================

model Objetivo {
  id               String         @id @default(uuid())
  titulo           String
  descripcion      String?        @db.Text
  fechaInicio      DateTime       @default(now()) @map("fecha_inicio")
  fechaFinPrevista DateTime?      @map("fecha_fin_prevista")
  estado           EstadoObjetivo @default(PENDIENTE)

  clienteId               String     @map("id_cliente")
  cliente                 Cliente    @relation(fields: [clienteId], references: [id])
  trabajadorResponsableId String     @map("id_trabajador_responsable")
  trabajadorResponsable   Trabajador @relation("ObjetivosAsignados", fields: [trabajadorResponsableId], references: [id])

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  @@map("objetivos")
}

model AreaDesarrollo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?  @db.Text
  color       String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  objetivosGenerales ObjetivoGeneral[]

  @@map("areas_desarrollo")
}

model ObjetivoGeneral {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("fecha_creacion")
  updatedAt   DateTime @updatedAt @map("ultima_actualizacion")

  areaDesarrolloId String         @map("id_area_desarrollo")
  areaDesarrollo   AreaDesarrollo @relation(fields: [areaDesarrolloId], references: [id])

  clientesQueLoTienen     ClienteObjetivo[]
  registrosDondeSeTrabajo RegistroDiarioObjetivo[]

  @@map("objetivos_generales")
}

// ============================================================
// SISTEMA GAS — DISEÑO NORMALIZADO
// ============================================================

model ClienteObjetivo {
  id              String   @id @default(uuid())
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("fecha_creacion")
  updatedAt       DateTime @updatedAt @map("fecha_actualizacion")

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  vecesTrabajado Int       @default(0) @map("veces_trabajado")
  ultimaVez      DateTime? @map("ultima_vez_trabajado")
  progreso       Int       @default(0)
  notas          String?

  // Desnormalizado para acceso rápido — se actualiza al crear una EvaluacionGAS
  nivelGASActual        Int?      @map("nivel_gas_actual")
  fechaUltimaEvaluacion DateTime? @map("fecha_ultima_evaluacion")

  objetivoGeneralId String          @map("id_objetivo_general")
  objetivoGeneral   ObjetivoGeneral @relation(fields: [objetivoGeneralId], references: [id], onDelete: Cascade)

  descripcionesNiveles DescripcionNivelGAS[]
  evaluaciones         EvaluacionGAS[]

  @@unique([clienteId, objetivoGeneralId])
  @@map("clientes_objetivos")
}

model DescripcionNivelGAS {
  id          String @id @default(uuid())
  nivel       Int // -2, -1, 0, 1, 2
  descripcion String @db.Text

  clienteObjetivoId String          @map("id_cliente_objetivo")
  clienteObjetivo   ClienteObjetivo @relation(fields: [clienteObjetivoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")

  @@unique([clienteObjetivoId, nivel])
  @@map("descripcion_niveles_gas")
}

model EvaluacionGAS {
  id    String   @id @default(uuid())
  nivel Int // -2, -1, 0, 1, 2
  notas String?  @db.Text
  fecha DateTime @default(now())

  clienteObjetivoId String          @map("id_cliente_objetivo")
  clienteObjetivo   ClienteObjetivo @relation(fields: [clienteObjetivoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("fecha_creacion")

  @@map("evaluaciones_gas")
}

model RegistroDiarioObjetivo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("fecha_creacion")

  notasRegistro String? @map("notas_registro") @db.Text

  registroDiarioId String         @map("id_registro_diario")
  registroDiario   RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)

  objetivoGeneralId String          @map("id_objetivo_general")
  objetivoGeneral   ObjetivoGeneral @relation(fields: [objetivoGeneralId], references: [id], onDelete: Cascade)

  @@unique([registroDiarioId, objetivoGeneralId])
  @@map("registros_diarios_objetivos")
}

model Bono {
  id                 String     @id @default(uuid())
  totalSesiones      Int        @map("total_sesiones")
  sesionesConsumidas Int        @default(0) @map("sesiones_consumidas")
  precio             Decimal    @db.Decimal(10, 2)
  tipoSesion         TipoSesion @default(PEDAGOGIA) @map("tipo_sesion")
  estado             EstadoBono @default(ACTIVO)
  pagado             Boolean    @default(false)
  metodoPago         String?    @map("metodo_pago")
  fechaPago          DateTime?  @map("fecha_pago")
  fechaInicio        DateTime   @default(now()) @map("fecha_inicio")
  fechaFin           DateTime?  @map("fecha_fin")
  notas              String?    @db.Text
  createdAt          DateTime   @default(now()) @map("fecha_creacion")
  updatedAt          DateTime   @updatedAt @map("ultima_actualizacion")

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  familiarPagoId String?   @map("id_familiar_pago")
  familiarPago   Familiar? @relation(fields: [familiarPagoId], references: [id])

  sesiones Sesion[]

  @@index([clienteId])
  @@index([estado])
  @@map("bonos")
}

// ============================================================
// ENUMS
// ============================================================

enum EstadoSesion {
  PROGRAMADA
  COMPLETADA
  CANCELADA_CON_AVISO
  CANCELADA_SIN_AVISO
  VACACIONES
}

enum TipoSesion {
  PEDAGOGIA
  NEUROPSICOLOGIA
  LOGOPEDIA
  TERAPIA_OCUPACIONAL
  EVALUACION
  REUNION_COLEGIO
}

/// Documento externo adjuntado al expediente del cliente (no generado por la app).
/// El fichero vive en Object Storage; aquí solo se guarda la clave y los metadatos.
model DocumentoCliente {
  id          String             @id @default(uuid())
  nombre      String
  descripcion String?            @db.Text
  categoria   CategoriaDocumento

  origen           OrigenDocumento       @default(SUBIDO)
  estadoFirma      EstadoFirmaDocumento? @map("estado_firma")
  /// Version de la plantilla con la que se genero. El RAT exige poder decir
  /// que texto exacto acepto la familia.
  plantillaVersion String?               @map("plantilla_version")
  fechaEnvio       DateTime?             @map("fecha_envio")

  /// Contrato del que nace este documento, si nace de uno.
  contratoId String?           @map("id_contrato")
  contrato   ContratoServicio? @relation("DocumentosContrato", fields: [contratoId], references: [id], onDelete: SetNull)

  /// El generado al que sustituye este PDF firmado.
  firmadoDeId String?           @unique @map("id_firmado_de")
  firmadoDe   DocumentoCliente? @relation("FirmaDocumento", fields: [firmadoDeId], references: [id], onDelete: SetNull)
  firmadoPor  DocumentoCliente? @relation("FirmaDocumento")

  /// Clave del objeto en Object Storage: `clientes/{clienteId}/documentos/{uuid}{ext}`
  storageKey  String @map("storage_key")
  mimeType    String @map("mime_type")
  tamanoBytes Int    @map("tamano_bytes")

  /// Fecha del documento en sí (p. ej. fecha del informe médico), no la de subida.
  fechaDocumento DateTime? @map("fecha_documento")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  clienteId String  @map("id_cliente")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  subidoPorId String     @map("id_subido_por")
  subidoPor   Trabajador @relation("DocumentosSubidos", fields: [subidoPorId], references: [id])

  /// El consentimiento RGPD que este documento acredita, si lo es.
  consentimiento ConsentimientoRgpd?

  @@index([clienteId])
  @@index([clienteId, categoria])
  @@index([createdAt])
  @@map("documentos_cliente")
}

