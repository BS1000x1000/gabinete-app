/// DISPONIBILIDAD declarada del terapeuta: los dias y horas en los que puede
/// ofrecer hueco a una familia (p. ej. lunes, miercoles y viernes de 15:00 a
/// 20:00). Convencion ISO 1=Lun..7=Dom, como ContratoSlot y HorarioAdmin.
///
/// El modelo se llama `HorarioLaboral` por historia, no por significado: nacio
/// como "jornada laboral", que es el concepto equivocado para un colectivo de
/// AUTONOMOS. Nadie aqui tiene jornada contratada; lo que si tiene, y necesita
/// declarar, es cuando acepta clientes. No se renombro a `Disponibilidad`
/// porque ese nombre ya esta cogido dos veces —`DisponibilidadCliente` y
/// `DisponibilidadClienteTrabajador`, mas el modulo `disponibilidad`— y un
/// tercero seria justo la ambiguedad que este esquema evita en otros sitios.
/// En la UI y en los avisos se llama disponibilidad, que es lo que es.
///
/// Es INFORMATIVA: nunca bloquea crear ni mover una sesion, solo genera el
/// aviso `FUERA_DE_DISPONIBILIDAD`. El gabinete a veces necesita meter una
/// sesion a deshora y la app no debe impedirselo. El horario del autonomo es
/// suyo: la app avisa de despistes, no impone un horario.
///
/// Un terapeuta sin ninguna fila aqui no genera ningun aviso.
///
/// No se reutiliza `HorarioAdmin` porque significa lo contrario: aquello son
/// bloques de tiempo OCUPADO por tareas administrativas dentro de esas horas.
model HorarioLaboral {
  id           String   @id @default(uuid())
  trabajadorId String   @map("id_trabajador")
  diaSemana    Int      @map("dia_semana")
  horaInicio   String   @map("hora_inicio")
  horaFin      String   @map("hora_fin")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("fecha_creacion")
  updatedAt    DateTime @updatedAt @map("ultima_actualizacion")

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@index([trabajadorId, diaSemana])
  @@map("horarios_laborales")
}

model HorarioAdmin {
  id           String         @id @default(uuid())
  trabajadorId String         @map("trabajador_id")
  trabajador   Trabajador     @relation(fields: [trabajadorId], references: [id])
  diaSemana    Int            @map("dia_semana") // 1=Lun, 2=Mar, ..., 7=Dom (ISO)
  horaInicio   String         @map("hora_inicio") // "HH:mm"
  horaFin      String         @map("hora_fin") // "HH:mm"
  titulo       String         @default("Tiempo de Administración")
  activo       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("fecha_creacion")
  updatedAt    DateTime       @updatedAt @map("ultima_actualizacion")
  overrides    EventoAgenda[]

  @@index([trabajadorId])
  @@map("horarios_admin")
}

