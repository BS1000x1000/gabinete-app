enum EstadoContrato {
  BORRADOR
  ACTIVO
  SUSPENDIDO
  FINALIZADO
}

model ContratoServicio {
  id           String         @id @default(uuid())
  clienteId    String         @map("id_cliente")
  trabajadorId String         @map("id_trabajador")
  tipoSesion   TipoSesion
  cuotaMensual Decimal        @map("cuota_mensual") @db.Decimal(10, 2)
  fechaInicio  DateTime       @map("fecha_inicio")
  fechaFin     DateTime?      @map("fecha_fin") // null = indefinido
  estado       EstadoContrato @default(ACTIVO)
  notas        String?        @db.Text
  fechaFirma   DateTime       @default(now()) @map("fecha_firma")

  /// PDF firmado subido por el gabinete. Cuando existe, sustituye al PDF que la
  /// app genera al vuelo: el documento que vale es el que han firmado las partes.
  storageKeyFirmado  String?   @map("storage_key_firmado")
  mimeTypeFirmado    String?   @map("mime_type_firmado")
  tamanoBytesFirmado Int?      @map("tamano_bytes_firmado")
  fechaSubidaFirmado DateTime? @map("fecha_subida_firmado")

  /// Hasta que fecha se han generado ya las sesiones de este contrato. La
  /// generacion es una ventana movil que un cron va empujando mes a mes, en vez
  /// de crear un anio entero de golpe: cuanto mas lejos se genera, mas sesiones
  /// hay que recolocar cuando la familia cambia de dia.
  generadoHasta DateTime? @map("generado_hasta")

  /// Ultima vez que se tocaron los campos del resumen (cuota, vigencia, slots).
  /// Si es posterior a `fechaSubidaFirmado`, el PDF firmado ya no refleja los
  /// datos con los que se factura y hay que avisar de ello.
  resumenModificadoAt DateTime? @map("resumen_modificado_at")

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("ultima_actualizacion")

  cliente    Cliente            @relation(fields: [clienteId], references: [id])
  trabajador Trabajador         @relation(fields: [trabajadorId], references: [id])
  slots      ContratoSlot[]
  documentos DocumentoCliente[] @relation("DocumentosContrato")
  sesiones   Sesion[]           @relation("SesionesContrato")
  facturas   Factura[]

  @@index([clienteId])
  @@index([trabajadorId])
  @@index([estado])
  @@map("contratos_servicio")
}

model ContratoSlot {
  id              String          @id @default(uuid())
  contratoId      String          @map("id_contrato")
  diaSemana       Int             @map("dia_semana") // 1=Lun..7=Dom (ISO)
  horaInicio      String          @map("hora_inicio") // "HH:mm"
  horaFin         String          @map("hora_fin")
  duracionMinutos Int             @map("duracion_minutos")
  modalidad       ModalidadSesion @default(PRESENCIAL)

  contrato ContratoServicio @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("contrato_slots")
}

// ============================================================
// FESTIVOS Y VACACIONES (Hito R2)
// ============================================================

enum AmbitoFestivo {
  NACIONAL
  AUTONOMICO
  LOCAL
}

/// Calendario del centro. Fila unica (id fijo "centro").
///
/// Los festivos son del CENTRO, no del cliente: un festivo local cierra el
/// local, no cierra a la familia. Antes se resolvian contra `Cliente.provincia`
/// -texto libre contra texto libre-, con lo que el ambito LOCAL era en realidad
/// provincial y no podia distinguir dos municipios de la misma provincia.
model ConfiguracionCentro {
  id         String   @id @default("centro")
  /// Codigo de `festivos/data/calendarios.ts`, no nombre libre. Ej: "MAD".
  ccaaCodigo String   @map("ccaa_codigo")
  /// Municipio del centro, tal cual la clave de `LOCALES`. Ej: "Fuenlabrada".
  municipio  String
  /// Provincia del centro. Solo se usa para el texto del contrato.
  provincia  String
  updatedAt  DateTime @updatedAt @map("ultima_actualizacion")

  @@map("configuracion_centro")
}

model Festivo {
  id          String        @id @default(uuid())
  /// Normalizada a las 12:00 UTC en TODOS los caminos de escritura
  /// (`normalizarDia()` en festivos.service.ts). El @@unique de abajo depende
  /// de esa normalizacion: dos filas del mismo dia natural con hora distinta no
  /// colisionarian. 12:00 y no 00:00 para que el dia local siga siendo el mismo
  /// se ejecute el contenedor en UTC o en Europe/Madrid.
  fecha       DateTime
  descripcion String
  ambito      AmbitoFestivo
  /// Codigo de CCAA ("MAD"), no nombre libre. Cadena vacia si NACIONAL.
  ccaa        String        @default("")
  /// Municipio, solo si LOCAL. Cadena vacia en otro caso.
  ///
  /// Centinela '' y no NULL a proposito: en Postgres varios NULL conviven en un
  /// indice unico, asi que con columnas nullable el @@unique no impediria el
  /// duplicado. Con '' si, y `createMany({ skipDuplicates })` empieza a servir
  /// para algo.
  municipio   String        @default("")
  anio        Int           @map("anio")

  @@unique([fecha, ccaa, municipio])
  @@index([anio])
  @@index([fecha])
  @@map("festivos")
}

model PeriodoVacaciones {
  id           String   @id @default(uuid())
  trabajadorId String   @map("id_trabajador")
  fechaInicio  DateTime @map("fecha_inicio")
  fechaFin     DateTime @map("fecha_fin")
  motivo       String?
  createdAt    DateTime @default(now()) @map("fecha_creacion")

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])

  @@index([trabajadorId])
  @@map("periodos_vacaciones")
}

